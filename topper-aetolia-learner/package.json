{
  "name": "topper-aetolia-learner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm:build && vite",
    "build": "npm run wasm:build:release && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "wasm:build": "wasm-pack build ./src-wasm --dev --target web --out-dir pkg",
    "wasm:build:release": "wasm-pack build ./src-wasm --release --target web --out-dir pkg"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.41.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
